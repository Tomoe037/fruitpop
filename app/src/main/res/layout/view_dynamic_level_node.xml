<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/btn_level_width"
    android:layout_height="@dimen/btn_level_width"
    android:clipChildren="false">

    <TextView
        android:id="@+id/txt_dynamic_level"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/btn_level"
        android:fontFamily="@font/baloo"
        android:gravity="center"
        android:textColor="@color/brown"
        android:textSize="@dimen/txt_level_size"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/image_dynamic_level_star"
        android:layout_width="@dimen/image_level_star_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:adjustViewBounds="true"
        android:src="@drawable/star_set_bg"
        android:visibility="invisible" />

</FrameLayout>
